# Local Netlify folder
.netlify

# Supabase CLI — local scratch only.
# supabase/migrations/ and supabase/config.toml MUST stay tracked: they are the
# schema history. `supabase` used to be ignored wholesale, which is how a
# migration file was once overwritten with no way to recover it.
supabase/.temp
supabase/.branches
supabase/dump
.scripts
scripts
# batch-scripts is NOT ignored (v0.60.1).
#
# It used to be, wholesale, and that quietly broke the weekly catalog
# maintenance workflow: .github/workflows/catalog-maintenance.yml runs
# `node batch-scripts/isbnBackfill.mjs`, and a fresh CI checkout had no such
# file. The job could only ever have worked on a machine that already had the
# untracked scripts — i.e. never in Actions.
#
# Generated results are ignored instead, one level down, in
# batch-scripts/.gitignore. Scripts are source; CSVs and logs are not.
# Vite writes one of these next to vite.config.js on every build/dev start and
# never cleans them up. 149 were committed before this line existed; clear them
# with:  git rm --cached "vite.config.js.timestamp-*"
vite.config.js.timestamp-*
