{
  "name": "wishlist-oracle",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sb": "npx supabase",
    "link:db": "npx supabase link --project-ref wwkqgnbnacajeqpdedbp",
    "pull:db": "npx supabase db pull",
    "push:db": "npx supabase db push",
    "diff:db": "npx supabase db diff -f",
    "new:db": "npx supabase migration new",
    "list:db": "npx supabase migration list",
    "dump:db": "npx supabase db dump -f supabase/dump/schema.sql",
    "dump:data": "npx supabase db dump --data-only -f supabase/dump/data.sql",
    "reset:db": "npx supabase db reset",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@supabase/supabase-js": "^2.45.0",
    "gsap": "^3.15.0",
    "image-size": "^2.0.2",
    "lenis": "^1.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "satori": "^0.26.0",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "sass": "^1.77.0",
    "supabase": "^2.22.6",
    "vite": "^5.3.0",
    "vite-plugin-pwa": "^0.20.0",
    "workbox-window": "^7.0.0"
  }
}
