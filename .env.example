# Copy this to .env.local and fill in your values. Never commit .env.local.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The client reads VITE_SUPABASE_PUBLISHABLE_KEY (see src/lib/supabase.js).
# This file said VITE_SUPABASE_ANON_KEY for months while the code read the other
# name, so a clean checkout produced a keyless client and "No API key found in
# request" from PostgREST. Copy the publishable key (sb_publishable_…) from
# Supabase → Settings → API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Optional affiliate tags for purchase links. Leave blank for plain links.
VITE_AMAZON_AFFILIATE_TAG=thebooksoracl-20
VITE_BOOKSHOP_AFFILIATE_ID=126628

# Optional PRH domain. Defaults to PRH.US. Set to PRH.MX for Mexico/LatAm
# (best for Costa Rica users), PRH.ESP for Spain.
# VITE_PRH_DOMAIN=PRH.MX

# ====== Server-side only (Netlify env vars) ======
# Do NOT put these in .env.local for production — they go in Netlify directly.
# Listed here for local dev with `netlify dev`:
# HARDCOVER_API_TOKEN=...
# ANTHROPIC_API_KEY=sk-ant-...
# PRH_API_KEY=...
