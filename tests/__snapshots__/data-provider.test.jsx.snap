exports[`loading > signed in, a shelf query fails: falls back to localStorage and caches nothing 1`] = `
{
  "calls": [
    {
      "ops": [
        [
          "select",
          "*",
        ],
        [
          "eq",
          "id",
          "u1",
        ],
        [
          "maybeSingle",
        ],
      ],
      "table": "profiles",
    },
    {
      "ops": [
        [
          "select",
          "id, added_at, notes, book:books(*, position_in_series, series:series(*))",
        ],
        [
          "eq",
          "user_id",
          "u1",
        ],
        [
          "order",
          "added_at",
          {
            "ascending": true,
          },
        ],
        [
          "order",
